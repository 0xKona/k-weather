# ─────────────────────────────────────────────────────────────────────────────
# K-Weather — environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
# CONFIGURATION
# ─────────────
# NEXT_PUBLIC_* variables are baked into the static build at build time.
#
# - Deployed: Set automatically by CDK on the Amplify Hosting branch.
# - Local dev: Copy this file to .env.local and fill in the values.
#
# LOCAL DEV SETUP
# ───────────────
# 1. Copy this file:
#      cp example.env .env.local
#
# 2. Fill in values from your test stack's CloudFormation outputs:
#      aws cloudformation describe-stacks \
#        --stack-name kweather-core-test \
#        --query 'Stacks[0].Outputs'
#
# 3. Start the dev server:
#      npm run frontend:dev
# ─────────────────────────────────────────────────────────────────────────────

# API Gateway base URL (include the trailing slash)
# CloudFormation output: ApiUrl
NEXT_PUBLIC_API_URL=
